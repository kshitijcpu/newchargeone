# ChargeOne backend — environment template (never commit real secrets)
PORT=4000
JWT_SECRET=replace-with-strong-random-secret

# Cloud Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/chargeone?retryWrites=true&w=majority
MONGODB_DB_NAME=chargeone

# Payment provider (sandbox only in the prototype)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# IoT / MQTT (production)
MQTT_URL=mqtts://broker.chargeone.internal:8883
MQTT_DEVICE_CA=/etc/chargeone/certs/ca.pem