# ChargeOne backend — environment configuration
PORT=4000
JWT_SECRET=chargeone-change-this-to-a-strong-random-secret-in-production
# Payment provider — add your Razorpay keys below to enable real payments
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Database (SQLite used by default — set for PostgreSQL in production)
# DATABASE_URL=postgresql://chargeone:password@localhost:5432/chargeone
